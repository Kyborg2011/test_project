APP_NAME="File Storage"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Docker -----------------------------------------------------------------
# Host port of the web interface.
APP_PORT=8080
# Host user/group the PHP containers run as (the Makefile fills them in automatically).
HOST_UID=1000
HOST_GID=1000
# Hard HTTP body limit for nginx and PHP. Must be larger than FILES_MAX_SIZE_KB,
# otherwise oversized uploads are cut by nginx before the application can validate them.
HTTP_MAX_BODY_SIZE=12M

# --- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=file_storage
DB_USERNAME=app
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail (letters are written to the log, no SMTP) -------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
# Host port of the RabbitMQ management UI (http://localhost:15672).
RABBITMQ_MANAGEMENT_PORT=15672
