APP_NAME="File Storage"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Docker -----------------------------------------------------------------
# Host port of the web interface.
APP_PORT=8080
# Host user/group the PHP containers run as (the Makefile fills them in automatically).
HOST_UID=1000
HOST_GID=1000
# Hard HTTP body limit for nginx and PHP. Must be larger than FILES_MAX_SIZE_KB,
# otherwise oversized uploads are cut by nginx before the application can validate them.
HTTP_MAX_BODY_SIZE=12M

# --- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=file_storage
DB_USERNAME=app
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Uploaded files ---------------------------------------------------------
# Storage disk (config/filesystems.php) and directory inside it.
FILES_DISK=local
FILES_DIRECTORY=uploads
# Maximum size of one file, KB (10240 = 10 MB). Keep it below HTTP_MAX_BODY_SIZE.
FILES_MAX_SIZE_KB=10240
# Comma-separated; each extension needs MIME types in config/files.php.
FILES_ALLOWED_EXTENSIONS=pdf,docx
# File lifetime before automatic deletion, minutes (1440 = 24 hours).
FILES_TTL_MINUTES=1440
# Files per page on the management page.
FILES_PER_PAGE=20
# Expired files processed per database query by the purge command.
FILES_PURGE_BATCH_SIZE=100

# --- Notifications ------------------------------------------------------------
# Recipient of the "file deleted" e-mails (published to RabbitMQ).
NOTIFICATION_EMAIL=admin@example.com

# --- Mail (letters are written to the log, no SMTP) -------------------------
# With MAIL_MAILER=log every letter is written in full to storage/logs/mail.log (MAIL_LOG_CHANNEL=mail).
# For real delivery set MAIL_MAILER=smtp and MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
# Host port of the RabbitMQ management UI (http://localhost:15672).
RABBITMQ_MANAGEMENT_PORT=15672
# Seconds.
RABBITMQ_CONNECTION_TIMEOUT=3
RABBITMQ_READ_WRITE_TIMEOUT=10
RABBITMQ_HEARTBEAT=30
# How long the relay waits for the broker to confirm a message, seconds.
RABBITMQ_PUBLISH_TIMEOUT=5
# Topology: exchange --routing key--> queue; rejected messages go to the dead letter queue.
RABBITMQ_EXCHANGE=notifications
RABBITMQ_ROUTING_KEY=email.send
RABBITMQ_QUEUE=notifications.email
RABBITMQ_DEAD_LETTER_EXCHANGE=notifications.dlx
RABBITMQ_DEAD_LETTER_QUEUE=notifications.email.dead
# Unacknowledged messages the consumer may hold at once.
RABBITMQ_CONSUMER_PREFETCH=10

# --- Outbox relay -------------------------------------------------------------
# Messages published per pass.
OUTBOX_BATCH_SIZE=50
# Pause when there is nothing to publish, milliseconds.
OUTBOX_POLL_INTERVAL_MS=1000
# Retry delay after a failed publish: base, x2 per attempt, capped by max. Seconds.
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
